# Koneksi Postgres. Kalau pakai integrasi Neon di Vercel, variabel ini terisi otomatis
# saat deploy — kamu cuma perlu mengisinya untuk development lokal.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password untuk membuka dashboard admin di /admin.
ADMIN_PASSWORD="ganti-dengan-password-yang-kuat"

# String acak panjang untuk menandatangani cookie sesi admin.
# Bikin dengan: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-string-acak-panjang"
